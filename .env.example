# Copy to .env.local (never commit .env.local)

# AWS Bedrock (Yared)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional overrides if `aws bedrock list-inference-profiles` shows different IDs
BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0  # haiku-5-5 is blocked on our account
BEDROCK_MODEL_SONNET=global.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_OPUS=global.anthropic.claude-opus-5-5

# Daytona (Yared)
DAYTONA_API_KEY=

# Arize AX (Bereket)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=pacer
